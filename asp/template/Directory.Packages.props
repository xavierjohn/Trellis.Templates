<Project>
  <PropertyGroup>
    <TrellisVersion>3.0.0-alpha.582</TrellisVersion>
    <TrellisSliVersion>10.0.0</TrellisSliVersion>
  </PropertyGroup>
  <!-- Runtime -->
  <ItemGroup>
    <!--#if (UseApiVersioning) -->
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <!--#endif -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!--#if (UseAzureMonitor) -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!--#endif -->
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="MartinCostello.Logging.XUnit.v3" Version="0.7.1" />
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Core" Version="2.3.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!--#if (UseSqlServer) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!-- Pin the patched transitive dependency until SQL Server packages update it. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!--#elseif (UsePostgres) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#endif -->
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <!--#if (UseOtlp) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <!--#endif -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.18.2" />
    <PackageVersion Include="Scalar.AspNetCore.Microsoft" Version="2.18.2" />
    <PackageVersion Include="System.Text.Json" Version="10.0.13" />
    <PackageVersion Include="Trellis.Analyzers" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Asp" Version="$(TrellisVersion)" />
    <!--#if (UseApiVersioning) -->
    <PackageVersion Include="Trellis.Asp.ApiVersioning" Version="$(TrellisVersion)" />
    <!--#endif -->
    <PackageVersion Include="Trellis.Asp.Idempotency.Cosmos" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Authorization" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Core" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.EntityFrameworkCore" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Http.Abstractions" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Mediator" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Mediator.FluentValidation" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Primitives" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.ResourceNaming.Azure" Version="0.1.0-preview.36" />
    <PackageVersion Include="Trellis.ServiceDefaults" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.ServiceLevelIndicators" Version="$(TrellisSliVersion)" />
    <PackageVersion Include="Trellis.ServiceLevelIndicators.Asp" Version="$(TrellisSliVersion)" />
    <!--#if (UseApiVersioning) -->
    <PackageVersion Include="Trellis.ServiceLevelIndicators.Asp.ApiVersioning" Version="$(TrellisSliVersion)" />
    <!--#endif -->
    <PackageVersion Include="Trellis.StateMachine" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Testing" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Testing.AspNetCore" Version="$(TrellisVersion)" />
  </ItemGroup>
  <!-- Test -->
  <ItemGroup>
    <!-- Trellis.Testing requires the FluentAssertions 7.x binary API. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="Xunit.DependencyInjection" Version="12.0.1" />
  </ItemGroup>
</Project>