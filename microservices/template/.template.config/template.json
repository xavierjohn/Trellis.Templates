{
  "$schema": "http://json.schemastore.org/template",
  "author": "Xavier John",
  "classifications": [
    "Web",
    "API",
    "Trellis",
    "DDD",
    "ROP",
    "Microservices",
    "Multi-tenant",
    "Authorization",
    "YARP",
    "Aspire"
  ],
  "identity": "Trellis.Microservices.Template",
  "name": "Trellis Microservices (Project Tracker)",
  "shortName": "trellis-microservices",
  "description": "Multi-tenant microservices topology using Trellis: YARP gateway minting internal-network JWTs + Projects (operational, 403 cross-tenant) + Members (HR-sensitive, HideExistence -> 404). Aspire-orchestrated. Demonstrates tenant_id ABAC isolation, resource-based authorization, the typed accessor (IAuthorizedResource), and the deny-overrides-allow JWT contract.",
  "preferNameDirectory": true,
  "defaultName": "MyTracker",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
    "filenameName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "identity",
      "replaces": "ProjectTracker",
      "fileRename": "ProjectTracker"
    },
    "nameNamespace": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "SafeNamespace"
    },
    "rootNamespace": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "",
      "description": "Root C# namespace. Defaults to the namespace derived from -n."
    },
    "effectiveNamespace": {
      "type": "generated",
      "generator": "coalesce",
      "parameters": {
        "sourceVariableName": "rootNamespace",
        "fallbackVariableName": "nameNamespace"
      },
      "replaces": "ProjectTrackerTemplate",
      "description": "Root namespace and assembly prefix."
    },
    "authorName": {
      "type": "parameter",
      "datatype": "string",
      "description": "Author name written into Directory.Build.props <Authors>.",
      "defaultValue": "Your Name"
    },
    "encodedAuthorName": {
      "type": "derived",
      "valueSource": "authorName",
      "valueTransform": "XmlEncode",
      "replaces": "TEMPLATE_AUTHOR_NAME"
    },
    "gatewayIssuerUrl": {
      "type": "parameter",
      "datatype": "string",
      "description": "Issuer / audience prefix the gateway mints internal JWTs against. Defaults to the local Aspire-pinned gateway URL so the template runs zero-config. Override with your production gateway URL (e.g. https://gateway.internal) before deploying.",
      "defaultValue": "http://localhost:5001",
      "replaces": "TEMPLATE_GATEWAY_ISSUER_URL"
    },
    "skipRestore": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Skip the post-creation NuGet restore.",
      "defaultValue": "false"
    },
    "apiVersioning": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "false",
      "replaces": "TEMPLATE_API_VERSIONING",
      "description": "Generate date-versioned HTTP APIs. Event and internal-JWT contract versions are unchanged."
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "sqlserver",
      "replaces": "TEMPLATE_DATABASE_PROVIDER",
      "isRequired": "deployment == \"azure\"",
      "choices": [
        { "choice": "sqlserver", "description": "SQL Server, provisioned by Aspire locally." },
        { "choice": "postgres", "description": "PostgreSQL, provisioned by Aspire locally." }
      ],
      "description": "Service database provider. Azure requires an explicit choice."
    },
    "auth": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "jwt",
      "replaces": "TEMPLATE_AUTH_PROVIDER",
      "choices": [
        { "choice": "jwt", "description": "Gateway ingress uses an external OIDC issuer." },
        { "choice": "entra", "description": "Gateway ingress uses Microsoft Entra ID." }
      ],
      "description": "Gateway identity provider. Downstream internal-JWT validation remains unchanged."
    },
    "telemetryExporters": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "otlp",
      "replaces": "TEMPLATE_TELEMETRY_EXPORTERS",
      "choices": [
        { "choice": "otlp", "description": "OTLP traces, metrics, and logs." },
        { "choice": "azure-monitor", "description": "Azure Monitor." },
        { "choice": "both", "description": "OTLP and Azure Monitor." }
      ],
      "description": "Generate only the selected telemetry exporters."
    },
    "deployment": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "none",
      "replaces": "TEMPLATE_DEPLOYMENT_MODE",
      "choices": [
        { "choice": "none", "description": "No deployment scaffold; local Aspire remains." },
        { "choice": "container", "description": "Container images and composition." },
        { "choice": "azure", "description": "Azure Container Apps and supporting resources." }
      ],
      "description": "Deployment scaffold. Aspire, Service Bus, and Cosmos production idempotency remain."
    },
    "UseApiVersioning": { "type": "computed", "value": "apiVersioning" },
    "UsePostgres": { "type": "computed", "value": "database == \"postgres\"" },
    "UseEntra": { "type": "computed", "value": "auth == \"entra\"" },
    "UseOtlp": { "type": "computed", "value": "telemetryExporters == \"otlp\" || telemetryExporters == \"both\"" },
    "UseAzureMonitor": { "type": "computed", "value": "telemetryExporters == \"azure-monitor\" || telemetryExporters == \"both\"" },
    "AzureDeployment": { "type": "computed", "value": "deployment == \"azure\"" },
    "httpApiVersionQuery": {
      "type": "generated",
      "generator": "switch",
      "parameters": {
        "cases": [
          { "condition": "apiVersioning", "value": "?api-version={{version}}" },
          { "condition": "", "value": "" }
        ]
      },
      "replaces": "?api-version={{version}}"
    },
    "templateSourcePragma": {
      "description": "Native template conditions require parentheses; the source-only style suppression is removed from generated code.",
      "type": "generated",
      "generator": "constant",
      "parameters": { "value": "" },
      "replaces": "#pragma warning disable IDE0047"
    }
  },
  "forms": {
    "SafeNamespace": {
      "identifier": "safe_namespace"
    },
    "XmlEncode": {
      "identifier": "xmlEncode"
    }
  },
  "sources": [
    {
      "copyOnly": [
        ".agentdocs/packages/**"
      ],
      "modifiers": [
        {
          "condition": "UseEntra",
          "exclude": [ "Gateway/src/GatewayClaimsActorProvider.cs" ]
        },
        {
          "exclude": [
            "**/bin/**",
            "**/obj/**",
            "**/.vs/**",
            "**/.git/**",
            "**/TestResults/**",
            ".template.config/**"
          ]
        },
        {
          "condition": "deployment != \"azure\"",
          "exclude": [ "infra/**", "deploy/**" ]
        },
        {
          "condition": "deployment == \"none\"",
          "exclude": [ "**/Dockerfile", "compose.yaml", ".dockerignore" ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "ProjectTracker.slnx" }
  ],
  "postActions": [
    {
      "condition": "(!skipRestore)",
      "description": "Restore NuGet packages",
      "manualInstructions": [
        { "text": "Run 'dotnet restore'" }
      ],
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "continueOnError": false
    }
  ]
}
