<Project>
  <!--
    Central package management. Versions are pinned here; project .csproj files
    add <PackageReference Include="..." /> without a Version attribute.
  -->

  <!-- Trellis package versions. Bump in lock-step with upstream releases:
       TrellisVersion              -> xavierjohn/Trellis (framework)
       TrellisMicroservicesVersion -> xavierjohn/Trellis.Microservices -->
  <PropertyGroup>
    <TrellisVersion>3.0.0-alpha.554</TrellisVersion>
    <TrellisMicroservicesVersion>0.1.0-alpha.76</TrellisMicroservicesVersion>
    <TrellisSliVersion>10.0.0-preview.34</TrellisSliVersion>
  </PropertyGroup>

  <!-- Runtime -->
  <ItemGroup>
    <!--#if (!NoApiVersioning) -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <PackageVersion Include="Asp.Versioning.OpenApi" Version="10.2.3" />
    <!--#endif -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!--#if (!NoAzureMonitor) -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!--#endif -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <!--#if (UsePostgres) -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!--#else -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <!--#endif -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery.Yarp" Version="10.10.0" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageVersion Include="Scalar.AspNetCore.Microsoft" Version="2.17.13" />
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- Aspire AppHost + OpenTelemetry -->
  <ItemGroup>
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.6.1" />
    <PackageVersion Include="Aspire.Hosting.Azure.ServiceBus" Version="13.6.1" />
    <!--#if (UsePostgres) -->
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />
    <!--#else -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.6.1" />
    <!--#endif -->
    <PackageVersion Include="Aspire.Azure.Messaging.ServiceBus" Version="13.6.1" />
    <!--#if (UsePostgres) -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.1" />
    <!--#else -->
    <PackageVersion Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.6.1" />
    <!--#endif -->
    <!--#if (!NoOtlp) -->
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!--#endif -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <!-- Upstream Trellis (xavierjohn/Trellis on nuget.org) -->
  <ItemGroup>
    <PackageVersion Include="Trellis.Analyzers" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Asp" Version="$(TrellisVersion)" />
    <!--#if (!NoApiVersioning) -->
    <PackageVersion Include="Trellis.Asp.ApiVersioning" Version="$(TrellisVersion)" />
    <!--#endif -->
    <PackageVersion Include="Trellis.Asp.Idempotency.Cosmos" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Authorization" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Core" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Http.Abstractions" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.EntityFrameworkCore" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.EntityFrameworkCore.Inbox" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.EntityFrameworkCore.Outbox" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Mediator" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Messaging.AzureServiceBus" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Primitives" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.ResourceNaming.Azure" Version="0.1.0-preview.32" />
    <PackageVersion Include="Trellis.ServiceDefaults" Version="$(TrellisVersion)" />
  </ItemGroup>

  <!-- Service Level Indicators (xavierjohn/ServiceLevelIndicators on nuget.org) -->
  <ItemGroup>
    <PackageVersion Include="Trellis.ServiceLevelIndicators" Version="$(TrellisSliVersion)" />
    <PackageVersion Include="Trellis.ServiceLevelIndicators.Asp" Version="$(TrellisSliVersion)" />
    <!--#if (!NoApiVersioning) -->
    <PackageVersion Include="Trellis.ServiceLevelIndicators.Asp.ApiVersioning" Version="$(TrellisSliVersion)" />
    <!--#endif -->
  </ItemGroup>

  <!-- Trellis.Microservices (xavierjohn/Trellis.Microservices on nuget.org) -->
  <ItemGroup>
    <PackageVersion Include="Trellis.Microservices.Abstractions" Version="$(TrellisMicroservicesVersion)" />
    <PackageVersion Include="Trellis.Microservices.AspNetCore" Version="$(TrellisMicroservicesVersion)" />
    <PackageVersion Include="Trellis.Yarp" Version="$(TrellisMicroservicesVersion)" />
  </ItemGroup>

  <!-- Mediator (Martin Othamar) — source-gen Mediator used by the services -->
  <ItemGroup>
    <PackageVersion Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageVersion Include="Mediator.SourceGenerator" Version="3.0.2" />
  </ItemGroup>

  <!-- Test framework (referenced from build/test.props for *.Tests projects) -->
  <ItemGroup>
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <!-- Trellis.Testing requires the FluentAssertions 7.x binary API. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Trellis.Testing" Version="$(TrellisVersion)" />
    <PackageVersion Include="Trellis.Testing.AspNetCore" Version="$(TrellisVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageVersion Include="MartinCostello.Logging.XUnit.v3" Version="0.7.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.1" />
  </ItemGroup>
</Project>
